package com.campusconnect.backend.service;

import org.springframework.mail.SimpleMailMessage;
import org.springframework.mail.javamail.JavaMailSender;
import org.springframework.stereotype.Service;

@Service
public class EmailService {

    private final JavaMailSender mailSender;

    public EmailService(JavaMailSender mailSender) {
        this.mailSender = mailSender;
    }

    public void sendRegistrationSuccessEmail(
            String recipientEmail,
            String name) {

        SimpleMailMessage message = new SimpleMailMessage();

        message.setTo(recipientEmail);
        message.setSubject(
                "CampusConnect - Registration Successful"
        );

        message.setText(
                "Hello " + name + ",\n\n" +
                "Your CampusConnect account has been " +
                "successfully created.\n\n" +
                "You can now log in and explore " +
                "internships and job opportunities.\n\n" +
                "Thank you,\n" +
                "CampusConnect Team"
        );

        mailSender.send(message);
    }
}